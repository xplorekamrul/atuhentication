generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/**
 * ===== Enums =====
 */
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminLevel {
  DEVELOPER
  SUPER_ADMIN
  ADMIN
}

enum UserType {
  ADMIN
  USER
}

/**
 * ===== ADMIN Models =====
 */

model Admin {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name          String?        @db.VarChar(50)
  email         String?        @unique @db.VarChar(50)
  username      String?        @unique @db.VarChar(50)
  emailVerified DateTime?      @map("email_verified")
  password      String         @db.VarChar(255)
  image         String?
  status        AccountStatus  @default(ACTIVE)
  suspendedAt   DateTime?      @map("suspended_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  level         AdminLevel     @default(ADMIN)
  userType      UserType       @default(ADMIN)
  adminRoles    AdminRole[]
  profile       Profile?       @relation("AdminProfile")
  loginHistory  LoginHistory[] @relation("AdminLoginHistory")

  @@index([email], map: "admins_email_idx")
  @@index([username], map: "admins_username_idx")
  @@index([status], map: "admins_status_idx")
  @@map("admins")
}

model AdminRole {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId   BigInt   @map("admin_id") @db.UnsignedBigInt
  roleId    BigInt   @map("role_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
  @@index([adminId], map: "admin_roles_admin_id_fkey")
  @@index([roleId], map: "admin_roles_role_id_fkey")
  @@map("admin_roles")
}

model Role {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name            String           @unique @db.VarChar(50)
  adminRoles      AdminRole[]
  roleRouteGroups RoleRouteGroup[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([name], map: "roles_name_idx")
  @@map("roles")
}

model RouteGroup {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name            String           @unique @db.VarChar(100)
  routes          Route[]
  roleRouteGroups RoleRouteGroup[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([name], map: "route_groups_name_idx")
  @@map("route_groups")
}

model Route {
  id                   BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  path                 String     @unique @db.VarChar(255)
  name                 String?    @db.VarChar(100)
  groupId              BigInt     @map("group_id") @db.UnsignedBigInt
  visibleToAdmin       Boolean    @default(true) @map("visible_to_admin")
  editableByAdmin      Boolean    @default(false) @map("editable_by_admin")
  visibleToSuperAdmin  Boolean    @default(true) @map("visible_to_super_admin")
  editableBySuperAdmin Boolean    @default(true) @map("editable_by_super_admin")
  group                RouteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now()) @map("created_at")

  @@index([groupId], map: "routes_group_id_fkey")
  @@index([path], map: "routes_path_idx")
  @@map("routes")
}

model RoleRouteGroup {
  roleId    BigInt     @map("role_id") @db.UnsignedBigInt
  groupId   BigInt     @map("group_id") @db.UnsignedBigInt
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group     RouteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@id([roleId, groupId])
  @@index([roleId], map: "role_route_groups_role_id_fkey")
  @@index([groupId], map: "role_route_groups_group_id_fkey")
  @@map("role_route_groups")
}

/**
 * ===== CUSTOMER/USER Models =====
 */

model User {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name          String?        @db.VarChar(50)
  email         String?        @unique @db.VarChar(50)
  username      String?        @unique @db.VarChar(50)
  emailVerified DateTime?      @map("email_verified")
  password      String         @db.VarChar(255)
  image         String?
  status        AccountStatus  @default(ACTIVE)
  suspendedAt   DateTime?      @map("suspended_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  userType      UserType       @default(USER)
  profile       Profile?       @relation("UserProfile")
  loginHistory  LoginHistory[] @relation("UserLoginHistory")

  @@index([email], map: "users_email_idx")
  @@index([username], map: "users_username_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

/**
 * ===== Shared Models =====
 */

model Profile {
  id      BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  adminId BigInt? @unique @map("admin_id") @db.UnsignedBigInt
  userId  BigInt? @unique @map("user_id") @db.UnsignedBigInt
  admin   Admin?  @relation("AdminProfile", fields: [adminId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  phone       String?   @db.VarChar(20)
  gender      String?   @db.VarChar(10)
  address     String?   @db.VarChar(255)
  profession  String?   @db.VarChar(100)
  hobbys      String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([adminId], map: "profile_admin_id_fkey")
  @@index([userId], map: "profile_user_id_fkey")
  @@map("profiles")
}

model LoginHistory {
  id      BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  adminId BigInt? @map("admin_id") @db.UnsignedBigInt
  userId  BigInt? @map("user_id") @db.UnsignedBigInt
  admin   Admin?  @relation("AdminLoginHistory", fields: [adminId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserLoginHistory", fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  location  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId], map: "login_history_admin_id_fkey")
  @@index([userId], map: "login_history_user_id_fkey")
  @@index([createdAt], map: "login_history_created_at_idx")
  @@map("login_history")
}

/**
 * ===== Password Reset =====
 */

model PasswordResetOtp {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email      String    @db.VarChar(255)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([email, codeHash])
  @@index([email], map: "password_reset_otp_email_idx")
  @@index([expiresAt], map: "password_reset_otp_expires_at_idx")
  @@map("password_reset_otp")
}
